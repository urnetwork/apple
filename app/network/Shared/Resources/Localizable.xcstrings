    "By participating in the network and providing bandwidth you can earn rewards." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من خلال المشاركة في الشبكة وتوفير عرض النطاق الترددي، يمكنك كسب المكافآت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účastí v síti a poskytováním šířky pásma můžete získat odměny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die Teilnahme am Netzwerk und das Bereitstellen von Bandbreite kannst du Belohnungen verdienen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμμετέχοντας στο δίκτυο και παρέχοντας εύρος ζώνης μπορείτε να κερδίσετε ανταμοιβές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By participating in the network and providing bandwidth you can earn rewards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al participar en la red y proporcionar ancho de banda puedes ganar recompensas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al participar en la red y proporcionar ancho de banda puedes ganar recompensas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En participant au réseau et en fournissant de la bande passante, vous pouvez gagner des récompenses."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בהשתתפות ברשת ובמתן רוחב פס תוכל להרוויח תגמולים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क में भाग लेकर और बैंडविड्थ प्रदान करके आप पुरस्कार कमा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan berpartisipasi di jaringan dan menyediakan bandwidth, Anda dapat memperoleh hadiah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partecipando alla rete e fornendo larghezza di banda puoi guadagnare ricompense."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークに参加して帯域幅を提供することで報酬を獲得できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크에 참여하고 대역폭을 제공하면 보상을 받을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door deel te nemen aan het netwerk en bandbreedte te leveren kun je beloningen verdienen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uczestnicząc w sieci i udostępniając przepustowość, możesz zdobywać nagrody."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao participar da rede e fornecer largura de banda, você pode ganhar recompensas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao participar na rede e fornecer largura de banda, pode ganhar recompensas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Участвуя в сети и предоставляя пропускную способность, вы можете получать награды."
          }
        },
        "sv" : {
          "stringUnit" : {
