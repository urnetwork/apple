    "Connections lost per provider failure. Lower is better" : {
      "comment" : "Developer tools screen: explanatory subtext under the 'blast radius' control.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاتصالات المفقودة لكل عطل في المزود. الأقل أفضل"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ztracená připojení na jedno selhání poskytovatele. Méně je lépe"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlorene Verbindungen pro Anbieterausfall. Niedriger ist besser"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέσεις που χάνονται ανά αστοχία παρόχου. Όσο λιγότερες, τόσο καλύτερα"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connections lost per provider failure. Lower is better"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiones perdidas por cada fallo de proveedor. Cuanto menos, mejor"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiones perdidas por cada falla de proveedor. Cuanto menos, mejor"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiones perdidas por cada falla de proveedor. Cuanto menos, mejor"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexions perdues par panne de fournisseur. Plus c’est bas, mieux c’est"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חיבורים שאבדו בכל כשל של ספק. פחות זה טוב יותר"
