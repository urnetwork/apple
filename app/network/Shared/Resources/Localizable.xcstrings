    "What a provider failure costs. Reset, run a test, read back." : {
      "comment" : "Developer tools screen: explanatory subtext under the 'measurements' control.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يكلّفه عطل المزود. أعد التعيين، وشغّل اختبارًا، واقرأ النتيجة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co stojí selhání poskytovatele. Resetujte, spusťte test, přečtěte výsledek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ein Anbieterausfall kostet. Zurücksetzen, Test ausführen, Ergebnis ablesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τι κοστίζει μια αστοχία παρόχου. Επαναφέρετε, εκτελέστε μια δοκιμή, διαβάστε το αποτέλεσμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What a provider failure costs. Reset, run a test, read back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que cuesta un fallo de proveedor. Restablece, ejecuta una prueba y lee el resultado."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que cuesta una falla de proveedor. Restablece, ejecuta una prueba y lee el resultado."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que cuesta una falla de proveedor. Restablece, ejecuta una prueba y lee el resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que coûte une panne de fournisseur. Réinitialisez, lancez un test, relisez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה עולה כשל של ספק. אפסו, הריצו בדיקה, קראו את התוצאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रदाता विफलता की कीमत क्या है। रीसेट करें, टेस्ट चलाएँ, नतीजा पढ़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa biaya satu kegagalan penyedia. Reset, jalankan tes, baca hasilnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto costa un guasto di un provider. Azzera, esegui un test, rileggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダー障害がどれだけの損失になるか。リセットしてテストを実行し、結果を確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제공자 장애가 어떤 손실을 낳는지 확인합니다. 재설정하고, 테스트를 실행하고, 결과를 읽으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat een providerstoring kost. Reset, voer een test uit, lees terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile kosztuje awaria dostawcy. Zresetuj, uruchom test, odczytaj wynik."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que custa uma falha de fornecedor. Reponha, execute um teste e leia o resultado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que custa uma falha de provedor. Redefina, execute um teste e leia o resultado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que custa uma falha de fornecedor. Reponha, execute um teste e leia o resultado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во что обходится сбой провайдера. Сбросьте, запустите тест, посмотрите результат."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad ett leverantörsfel kostar. Återställ, kör ett test, läs av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความล้มเหลวของผู้ให้บริการหนึ่งครั้งมีต้นทุนเท่าใด รีเซ็ต รันการทดสอบ แล้วอ่านผล"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чого коштує збій провайдера. Скиньте, запустіть тест, перегляньте результат."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một sự cố nhà cung cấp gây ra tổn thất gì. Đặt lại, chạy thử, đọc kết quả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供商故障的代价。重置、运行测试、读取结果。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供應商故障的代價。重設、執行測試、讀取結果。"
          }
        }
      }
    },
    "When a provider can't reach a site, move the connection to another exit instead of letting it hang" : {
      "comment" : "Developer tools screen: explanatory subtext under the 'dial failure rerace' control.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يتعذّر على المزود الوصول إلى موقع، يُنقل الاتصال إلى مخرج آخر بدلًا من تركه معلّقًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když poskytovatel nedosáhne na web, přesune připojení na jiný výstup, místo aby zůstalo viset"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein Anbieter eine Website nicht erreicht, wird die Verbindung auf einen anderen Exit verlegt, statt sie hängen zu lassen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν ένας πάροχος δεν μπορεί να φτάσει σε έναν ιστότοπο, μετακινεί τη σύνδεση σε άλλη έξοδο αντί να την αφήνει να κρέμεται"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a provider can't reach a site, move the connection to another exit instead of letting it hang"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando un proveedor no puede llegar a un sitio, mueve la conexión a otra salida en lugar de dejarla colgada"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando un proveedor no puede llegar a un sitio, mueve la conexión a otra salida en lugar de dejarla colgada"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando un proveedor no puede llegar a un sitio, mueve la conexión a otra salida en lugar de dejarla colgada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand un fournisseur ne peut pas joindre un site, déplace la connexion vers une autre sortie au lieu de la laisser en suspens"
