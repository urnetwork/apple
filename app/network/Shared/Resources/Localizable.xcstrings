    "This connection measured slower than clients need, so it is offered much less often." : {
      "comment" : "Provider status reason (slow): past the speed or delay cutoff.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قيست سرعة هذا الاتصال بأقل مما يحتاجه العملاء، لذا يُعرض بوتيرة أقل بكثير."
