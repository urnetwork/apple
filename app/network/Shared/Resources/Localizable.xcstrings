          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תשלומי USDC עוברים לארנק Solana או Polygon אחר שלך, או מוחזקים עד שתחבר אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
