<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS build of the same target. App group identifiers are team-id prefixed
  on macOS (see extension/extension-macOS.entitlements for why the team id is
  written out literally). Wired by CODE_SIGN_ENTITLEMENTS[sdk=macosx*].
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>6BGU69Q742.group.network.ur</string>
	</array>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
</dict>
</plist>
