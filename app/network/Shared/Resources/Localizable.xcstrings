          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маскируется под DNS-трафик с постоянной подкачкой ответов. Минимальная пропускная способность, максимальная доступность."
          }
        },
        "sv" : {
