          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emisja trafia bezpośrednio na twój coldkey. Powiązania odnawiają się w każdej epoce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
