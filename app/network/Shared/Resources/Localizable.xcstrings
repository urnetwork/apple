      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحتجز مدفوعات USDC حتى يتم ربط محفظة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USDC-Auszahlungen werden zurückgehalten, bis eine andere Wallet verbunden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USDC payouts are held until another wallet is connected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pagos en USDC quedan retenidos hasta que se conecte otra billetera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выплаты в USDC приостанавливаются, пока не будет подключен другой кошелек."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在连接其他钱包之前，USDC 支付将被暂停。"
          }
        }
      }
    },
    "USDC payouts continue to this wallet until the migration to Bittensor is complete." : {
      "comment" : "Second paragraph of the Solana connect sheet/card, and the body line under a connected Solana wallet.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستمر مدفوعات USDC إلى هذه المحفظة حتى اكتمال الانتقال إلى Bittensor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výplaty v USDC budou chodit do této peněženky, dokud se nedokončí přechod na Bittensor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USDC-Auszahlungen gehen weiterhin an diese Wallet, bis die Migration zu Bittensor abgeschlossen ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι πληρωμές σε USDC συνεχίζουν σε αυτό το πορτοφόλι μέχρι να ολοκληρωθεί η μετάβαση στο Bittensor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USDC payouts continue to this wallet until the migration to Bittensor is complete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pagos en USDC seguirán llegando a esta billetera hasta que se complete la migración a Bittensor."
