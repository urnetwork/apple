    "Shared only with your own devices. Choose Always to share with everyone." : {
      "comment" : "Provider card, under the provide mode row: the provide mode is Network, so the device shares only with the user's own devices. 'Always' is the provide mode label (key always).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم المشاركة مع أجهزتك فقط. اختر «دائمًا» للمشاركة مع الجميع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdíleno jen s vašimi vlastními zařízeními. Zvolte Vždy a sdílejte se všemi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur mit deinen eigenen Geräten geteilt. Wähle Immer, um mit allen zu teilen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κοινοποιείται μόνο στις δικές σας συσκευές. Επιλέξτε Πάντα για κοινή χρήση με όλους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared only with your own devices. Choose Always to share with everyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se comparte con tus propios dispositivos. Elige Siempre para compartir con todos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se comparte con tus propios dispositivos. Elige Siempre para compartir con todos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se comparte con tus propios dispositivos. Elige Siempre para compartir con todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagé uniquement avec vos propres appareils. Choisissez Toujours pour partager avec tout le monde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משותף רק עם המכשירים שלך. בחר תמיד כדי לשתף עם כולם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल आपके अपने डिवाइस के साथ साझा किया गया। सभी के साथ साझा करने के लिए हमेशा चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya dibagikan dengan perangkat Anda sendiri. Pilih Selalu untuk berbagi dengan semua orang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condiviso solo con i tuoi dispositivi. Scegli Sempre per condividere con tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のデバイスとのみ共有しています。すべての人と共有するには「常に」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 기기와만 공유됩니다. 모든 사람과 공유하려면 '항상'을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen gedeeld met je eigen apparaten. Kies Altijd om met iedereen te delen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępniane tylko Twoim urządzeniom. Wybierz Zawsze, aby udostępniać wszystkim."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partilhado apenas com os seus dispositivos. Escolha Sempre para partilhar com todos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhado apenas com seus próprios dispositivos. Escolha Sempre para compartilhar com todos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partilhado apenas com os seus dispositivos. Escolha Sempre para partilhar com todos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ предоставляется только вашим устройствам. Выберите «Всегда», чтобы предоставлять его всем."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delas bara med dina egna enheter. Välj Alltid för att dela med alla."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชร์เฉพาะกับอุปกรณ์ของคุณเอง เลือก ตลอดเวลา เพื่อแชร์กับทุกคน"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ надається лише вашим пристроям. Виберіть «Завжди», щоб надавати його всім."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ chia sẻ với thiết bị của riêng bạn. Chọn Luôn luôn để chia sẻ với mọi người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅与你自己的设备共享。选择“始终”即可与所有人共享。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只與你自己的裝置分享。選擇「始終」即可與所有人分享。"
          }
        }
      }
