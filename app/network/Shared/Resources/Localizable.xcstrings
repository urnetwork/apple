    "Delay measured above what is expected for this location. Lower delay is offered more often." : {
      "comment" : "Provider status 'Why?' list: explanation under the delay.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التأخير المقيس فوق المتوقع لهذا الموقع. يُعرض التأخير الأقل بوتيرة أكبر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpoždění naměřené nad rámec očekávaného pro tuto polohu. Nižší zpoždění se nabízí častěji."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemessene Verzögerung über dem für diesen Standort erwarteten Wert. Geringere Verzögerung wird häufiger angeboten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καθυστέρηση που μετρήθηκε πάνω από την αναμενόμενη για αυτή την τοποθεσία. Η μικρότερη καθυστέρηση προτείνεται συχνότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delay measured above what is expected for this location. Lower delay is offered more often."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latencia medida por encima de la esperada para esta ubicación. Las conexiones con menos latencia se ofrecen con más frecuencia."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latencia medida por encima de la esperada para esta ubicación. Las conexiones con menos latencia se ofrecen con más frecuencia."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latencia medida por encima de la esperada para esta ubicación. Las conexiones con menos latencia se ofrecen con más frecuencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latence mesurée au-delà de celle attendue pour cet emplacement. Une latence plus faible est proposée plus souvent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השהיה שנמדדה מעבר לצפוי עבור המיקום הזה. השהיה נמוכה יותר מוצעת לעיתים קרובות יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस स्थान के लिए अपेक्षित से अधिक मापा गया विलंब। कम विलंब वाले कनेक्शन अधिक बार पेश किए जाते हैं।"
