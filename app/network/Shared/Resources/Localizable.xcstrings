          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ foi transferida e verificada. Arraste a nova URnetwork para a pasta Aplicações e abra-a a partir daí."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версия %@ загружена и проверена. Перетащите новый URnetwork в папку «Программы» и откройте его оттуда."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har hämtats och verifierats. Dra den nya URnetwork till mappen Program och öppna den sedan därifrån."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดาวน์โหลดและตรวจสอบ %@ แล้ว ลาก URnetwork ตัวใหม่ไปไว้ในโฟลเดอร์แอปพลิเคชัน แล้วเปิดจากที่นั่น"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Версію %@ завантажено й перевірено. Перетягніть новий URnetwork у папку «Програми» й відкрийте його звідти."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã được tải về và xác minh. Kéo URnetwork mới vào thư mục Ứng dụng, rồi mở từ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
