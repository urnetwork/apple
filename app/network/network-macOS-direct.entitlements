<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Direct-download macOS build (URnetworkDirect target, Developer ID signed,
  distributed as a DMG outside the Mac App Store). The tunnel is a SYSTEM
  extension in this build, which is why the networkextension entitlement
  names the "-systemextension" packet tunnel variant and the app carries
  system-extension.install. Its own product family, com.bringyour.urnetwork:
  bundle id, app group and keychain group all differ from the App Store
  build (network-macOS.entitlements) so the two install side by side and
  are provisioned as separate App IDs (see TunnelProviderIdentity.swift);
  the team id in the app group is literal for the reason explained there.
  Not carried over from the App Store entitlements: aps-environment (no push
  in the direct build), increased-memory-limit and sustained-execution (iOS
  entitlements that a Developer ID profile does not grant) and dns-proxy
  (the tunnel only registers a packet tunnel provider).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>6BGU69Q742.group.com.bringyour.urnetwork</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider-systemextension</string>
		<string>dns-settings</string>
	</array>
	<key>com.apple.developer.networking.vpn.api</key>
	<array>
		<string>allow-vpn</string>
	</array>
	<key>com.apple.developer.system-extension.install</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.bringyour.urnetwork.tunnel-credentials</string>
	</array>
</dict>
</plist>
