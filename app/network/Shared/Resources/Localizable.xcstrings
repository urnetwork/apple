          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте хост выше или нажмите на трафик ниже, чтобы направить его локально или закрепить за одним провайдером."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till en värd ovan, eller tryck på trafik nedan för att dirigera den lokalt eller hålla den till en leverantör."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มโฮสต์ด้านบน หรือแตะทราฟฟิกด้านล่างเพื่อส่งผ่านภายในเครื่องหรือคงไว้กับผู้ให้บริการรายเดียว"
