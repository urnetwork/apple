        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחובר לפרוטוקול UR. המימושים מגיעים לכאן. ה-Alpha מצטבר החל מהתקופה שאחרי החיבור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UR प्रोटोकॉल से कनेक्टेड। दावे यहीं आते हैं। Alpha कनेक्ट करने के बाद वाले एपोक से जमा होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
