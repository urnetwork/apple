          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sont réservés à vos connexions ouvertes. Ce qu’elles n’utilisent pas vous est rendu à mesure qu’elles se ferment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
