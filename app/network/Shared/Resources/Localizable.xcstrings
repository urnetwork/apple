    "A private extender replaces every discovered extender. Leave it empty to use discovery." : {
      "comment" : "Help text under the private extender fields.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحلّ الموسّع الخاص محل كل الموسّعات المكتشفة. اتركه فارغًا لاستخدام الاكتشاف التلقائي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soukromý extender nahradí všechny nalezené extendery. Ponechte prázdné, chcete-li používat vyhledávání."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
