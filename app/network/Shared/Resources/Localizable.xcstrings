    "URnetwork is powered by the world's largest, safest,\nand most decentralized ingress and egress protocol." : {
      "comment" : "Call to action",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل URnetwork ببروتوكول الدخول والخروج الأكبر\nوالأكثر أمانًا ولامركزية في العالم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork stojí na největším, nejbezpečnějším a nejvíce\ndecentralizovaném protokolu na světě pro příchozí a odchozí provoz."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork basiert auf dem weltweit größten, sichersten\nund am stärksten dezentralisierten Ingress- und Egress-Protokoll."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το URnetwork τροφοδοτείται από το μεγαλύτερο, ασφαλέστερο\nκαι πιο αποκεντρωμένο πρωτόκολλο εισόδου και εξόδου στον κόσμο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork is powered by the world's largest, safest,\nand most decentralized ingress and egress protocol."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork funciona con el protocolo de entrada y salida\nmás grande, seguro y descentralizado del mundo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork funciona con el protocolo de entrada y salida\nmás grande, seguro y descentralizado del mundo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork funciona con el protocolo de entrada y salida\nmás grande, seguro y descentralizado del mundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork repose sur le protocole d'entrée et de sortie\nle plus vaste, le plus sûr et le plus décentralisé au monde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork מבוססת על פרוטוקול הכניסה והיציאה\nהגדול, הבטוח והמבוזר ביותר בעולם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork दुनिया के सबसे बड़े, सबसे सुरक्षित\nऔर सबसे विकेंद्रीकृत प्रवेश-निकास प्रोटोकॉल पर चलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork didukung oleh protokol ingress dan egress\nterbesar, teraman, dan paling terdesentralisasi di dunia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork si basa sul protocollo di ingresso e uscita\npiù grande, sicuro e decentralizzato al mondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetworkは、世界最大で最も安全、最も分散化された\nイングレス・エグレスプロトコルを基盤としています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork는 세계에서 가장 크고 안전하며 가장 분산화된\n인그레스·이그레스 프로토콜로 구동됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork draait op het grootste, veiligste en meest\ngedecentraliseerde ingress- en egress-protocol ter wereld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URnetwork opiera się na największym, najbezpieczniejszym i najbardziej\nzdecentralizowanym na świecie protokole wejścia i wyjścia."
          }
