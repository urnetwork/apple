<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The packet tunnel as a SYSTEM extension (URnetworkVPNSystem target), for the
  direct-download macOS build. It runs as root, so it deliberately carries no
  keychain-access-groups: the DIRECT_DOWNLOAD code paths never read the user's
  keychain or the user's app-group container -- everything the tunnel needs
  arrives in NETunnelProviderProtocol.providerConfiguration and its logs go to
  /Library/Logs/URnetwork (see DiagnosticsLogContract). The app group is the
  direct build's own (com.bringyour.urnetwork, see TunnelProviderIdentity.swift)
  and is there because NEMachServiceName (Info-macOS-sysext.plist) must be
  prefixed by one of the extension's app groups; the literal team id is
  explained in extension-macOS.entitlements.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>6BGU69Q742.group.com.bringyour.urnetwork</string>
	</array>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider-systemextension</string>
	</array>
</dict>
</plist>
