        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อผู้ให้บริการเข้าถึงเว็บไซต์ไม่ได้ ให้ย้ายการเชื่อมต่อไปยังทางออกอื่นแทนการปล่อยค้างไว้"
