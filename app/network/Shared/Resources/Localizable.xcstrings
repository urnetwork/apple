    "%@ was downloaded and verified. Drag the new URnetwork into the Applications folder, then open it from there." : {
      "comment" : "macOS Settings > Software update status when the app could not replace itself. {version} is the downloaded release's version.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تنزيل %@ والتحقق منه. اسحب URnetwork الجديد إلى مجلد التطبيقات، ثم افتحه من هناك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verze %@ byla stažena a ověřena. Přetáhněte novou aplikaci URnetwork do složky Aplikace a otevřete ji odtud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde heruntergeladen und geprüft. Ziehe das neue URnetwork in den Ordner „Programme“ und öffne es dann von dort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η %@ λήφθηκε και επαληθεύτηκε. Σύρετε το νέο URnetwork στον φάκελο Εφαρμογές και ανοίξτε το από εκεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was downloaded and verified. Drag the new URnetwork into the Applications folder, then open it from there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se descargó y verificó. Arrastra el nuevo URnetwork a la carpeta Aplicaciones y ábrelo desde allí."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se descargó y verificó. Arrastra el nuevo URnetwork a la carpeta Aplicaciones y ábrelo desde allí."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se descargó y verificó. Arrastra el nuevo URnetwork a la carpeta Aplicaciones y ábrelo desde allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été téléchargée et vérifiée. Faites glisser le nouvel URnetwork dans le dossier Applications, puis ouvrez-le depuis cet emplacement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ הורדה ואומתה. גררו את URnetwork החדש לתיקייה ״יישומים״ ופתחו אותו משם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ डाउनलोड और सत्यापित हो गया। नए URnetwork को ऐप्लिकेशन फ़ोल्डर में खींचें, फिर वहीं से खोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sudah diunduh dan diverifikasi. Seret URnetwork yang baru ke folder Aplikasi, lalu buka dari sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stata scaricata e verificata. Trascina il nuovo URnetwork nella cartella Applicazioni, poi aprilo da lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ をダウンロードして検証しました。新しい URnetwork を「アプリケーション」フォルダにドラッグし、そこから開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 다운로드하고 확인했습니다. 새 URnetwork를 응용 프로그램 폴더로 드래그한 다음 그곳에서 여세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is gedownload en gecontroleerd. Sleep de nieuwe URnetwork naar de map Apps en open hem vanaf daar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wersja %@ została pobrana i zweryfikowana. Przeciągnij nowy URnetwork do folderu Aplikacje, a następnie otwórz go stamtąd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ foi baixada e verificada. Arraste a nova URnetwork para a pasta Aplicativos e abra-a a partir de lá."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
