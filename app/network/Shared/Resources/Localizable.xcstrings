    "Speed measured through this device. Faster connections are offered more often." : {
      "comment" : "Provider status 'Why?' list: explanation under the speed test.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السرعة المقيسة عبر هذا الجهاز. تُعرض الاتصالات الأسرع بوتيرة أكبر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rychlost naměřená přes toto zařízení. Rychlejší připojení se nabízejí častěji."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über dieses Gerät gemessene Geschwindigkeit. Schnellere Verbindungen werden häufiger angeboten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ταχύτητα που μετρήθηκε μέσω αυτής της συσκευής. Οι ταχύτερες συνδέσεις προτείνονται συχνότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speed measured through this device. Faster connections are offered more often."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad medida a través de este dispositivo. Las conexiones más rápidas se ofrecen con más frecuencia."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad medida a través de este dispositivo. Las conexiones más rápidas se ofrecen con más frecuencia."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidad medida a través de este dispositivo. Las conexiones más rápidas se ofrecen con más frecuencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vitesse mesurée via cet appareil. Les connexions plus rapides sont proposées plus souvent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המהירות שנמדדה דרך המכשיר הזה. חיבורים מהירים יותר מוצעים לעיתים קרובות יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस के ज़रिए मापी गई गति। तेज़ कनेक्शन अधिक बार पेश किए जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kecepatan yang diukur melalui perangkat ini. Koneksi yang lebih cepat lebih sering ditawarkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocità misurata tramite questo dispositivo. Le connessioni più veloci vengono offerte più spesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスを通じて測定された速度です。速い接続ほど頻繁に提示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기를 통해 측정된 속도입니다. 빠른 연결일수록 더 자주 제시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snelheid gemeten via dit apparaat. Snellere verbindingen worden vaker aangeboden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prędkość zmierzona przez to urządzenie. Szybsze połączenia są proponowane częściej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade medida através deste dispositivo. As ligações mais rápidas são oferecidas com mais frequência."
          }
