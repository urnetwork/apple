          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy kết nối để dùng các công cụ cho kết nối đang hoạt động. Phần chẩn đoán bên dưới vẫn dùng được trong cả hai trường hợp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
