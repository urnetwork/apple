          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mức trễ của bộ hẹn giờ, tính bằng ms, được hiểu là điện thoại tạm ngưng thay vì điểm thoát bị kẹt, để điện thoại vừa hoạt động lại không kết luận lỗi mọi điểm thoát cùng lúc. Tắt sẽ vô hiệu hóa nó"
          }
        },
        "zh-Hans" : {
