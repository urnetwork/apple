<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Per-target values (the App Store and direct-download app targets share
	     this file) come from build settings: UR_SHARED_KEYCHAIN_ACCESS_GROUP,
	     UR_TUNNEL_PROVIDER_BUNDLE_ID, UR_GOOGLE_CLIENT_ID and
	     UR_GOOGLE_URL_SCHEME, set per target in project.pbxproj. -->
	<key>URSharedKeychainAccessGroup</key>
	<string>$(UR_SHARED_KEYCHAIN_ACCESS_GROUP)</string>
	<key>ATSApplicationFontsPath</key>
	<string>.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>network.ur.update-tunnel</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(UR_GOOGLE_URL_SCHEME)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>urnetwork</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>urnetwork</string>
			</array>
		</dict>
	</array>
	<key>GIDClientID</key>
	<string>$(UR_GOOGLE_CLIENT_ID)</string>
	<key>INIntentsSupported</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).DisconnectIntent</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).ConnectIntent</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>solflare</string>
		<string>phantom</string>
	</array>
	<key>URAcceptanceBuildID</key>
	<string>$(URNETWORK_ACCEPTANCE_BUILD_ID)</string>
	<key>URHardwareUITestNonce</key>
	<string>$(URNETWORK_HARDWARE_UI_TEST_NONCE)</string>
	<key>NEVPNConfiguration</key>
	<array>
		<string>$(UR_TUNNEL_PROVIDER_BUNDLE_ID)</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>SMAppService</key>
	<dict>
		<key>LaunchHelperBundleIdentifier</key>
		<string>network.ur.launch</string>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>PPNeueMontreal-Regular.ttf</string>
		<string>PPNeueBit-Bold.ttf</string>
		<string>ABCGravity-ExtraCondensed.otf</string>
		<string>ABCGravity-Extended.otf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
