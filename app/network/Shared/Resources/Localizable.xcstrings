    "We're confirming your purchase. Your plan will update automatically." : {
      "comment" : "Purchase confirmation message while the app waits for the payment to be confirmed.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نؤكد عملية الشراء الآن. ستُحدَّث خطتك تلقائيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
