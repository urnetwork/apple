    "Add a host above, or tap traffic below to route it locally or hold it to one provider." : {
      "comment" : "Split rules screen: hint shown while there are no rules yet. Routing locally sends traffic outside the VPN; holding to one provider keeps a site on the same VPN exit.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف مضيفًا أعلاه، أو انقر على حركة المرور أدناه لتوجيهها محليًا أو إبقائها على مزود واحد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte hostitele výše nebo klepněte na provoz níže, abyste ho směrovali lokálně nebo drželi u jednoho poskytovatele."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge oben einen Host hinzu oder tippe unten auf Datenverkehr, um ihn lokal zu leiten oder bei einem Anbieter zu halten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε έναν host παραπάνω ή πατήστε την κίνηση παρακάτω για να τη δρομολογήσετε τοπικά ή να την κρατήσετε σε έναν πάροχο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a host above, or tap traffic below to route it locally or hold it to one provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un host arriba o pulsa el tráfico de abajo para enrutarlo localmente o mantenerlo en un solo proveedor."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega un host arriba o toca el tráfico de abajo para enrutarlo localmente o mantenerlo en un solo proveedor."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega un host arriba o toca el tráfico de abajo para enrutarlo localmente o mantenerlo en un solo proveedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un hôte ci-dessus, ou appuyez sur le trafic ci-dessous pour le router localement ou le garder sur un seul fournisseur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסיפו מארח למעלה, או הקישו על התעבורה שלמטה כדי לנתב אותה מקומית או להשאיר אותה אצל ספק אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊपर एक होस्ट जोड़ें, या नीचे किसी ट्रैफ़िक पर टैप करें ताकि वह स्थानीय रूप से रूट हो या एक प्रदाता पर रहे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan host di atas, atau ketuk lalu lintas di bawah untuk merutekannya secara lokal atau menahannya di satu penyedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un host qui sopra, oppure tocca il traffico qui sotto per instradarlo localmente o mantenerlo su un solo provider."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上でホストを追加するか、下のトラフィックをタップして、ローカルにルーティングするか 1 つのプロバイダーに固定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위에서 호스트를 추가하거나 아래 트래픽을 탭하여 로컬로 라우팅하거나 하나의 제공업체에 고정하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg hierboven een host toe, of tik hieronder op verkeer om het lokaal te routeren of bij één provider te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj host powyżej lub stuknij ruch poniżej, aby kierować go lokalnie albo trzymać przy jednym dostawcy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um host acima ou toque no tráfego abaixo para roteá-lo localmente ou mantê-lo em um único provedor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
