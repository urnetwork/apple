        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปลอมตัวเป็นทราฟฟิก DNS พร้อมการปั๊มคำตอบอย่างต่อเนื่อง แบนด์วิดท์ต่ำที่สุด ความพร้อมใช้งานสูงที่สุด"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маскується під трафік DNS зі сталою помпою відповідей. Найнижча пропускна здатність, найвища доступність."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngụy trang thành lưu lượng DNS với luồng phản hồi liên tục. Băng thông thấp nhất, khả dụng cao nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
