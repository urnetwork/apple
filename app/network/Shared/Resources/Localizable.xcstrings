    "Keeps one exit for the session; changes only if that provider goes offline." : {
      "comment" : "Subtitle under the Fixed IP toggle in the connect options. With Fixed IP on, the connection keeps the same exit (provider) for the whole session, so the egress IP stays the same unless that provider goes offline.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ بمخرج واحد طوال الجلسة؛ ولا يتغير إلا إذا انقطع اتصال ذلك المزود."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechá jeden výstup po celou relaci; změní se, jen když se tento poskytovatel odpojí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält einen Exit für die Sitzung; wechselt nur, wenn dieser Anbieter offline geht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διατηρεί μία έξοδο για όλη τη συνεδρία· αλλάζει μόνο αν αυτός ο πάροχος αποσυνδεθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps one exit for the session; changes only if that provider goes offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene una sola salida durante la sesión; solo cambia si ese proveedor se desconecta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene una sola salida durante la sesión; solo cambia si ese proveedor se desconecta."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene una sola salida durante la sesión; solo cambia si ese proveedor se desconecta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve une seule sortie pendant la session ; elle ne change que si ce fournisseur se déconnecte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שומר על יציאה אחת לאורך ההפעלה; משתנה רק אם הספק הזה מתנתק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे सत्र में एक ही एग्ज़िट रखता है; यह तभी बदलता है जब वह प्रदाता ऑफ़लाइन हो जाए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mempertahankan satu titik keluar selama sesi; hanya berubah jika penyedia tersebut offline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene una sola uscita per tutta la sessione; cambia solo se quel provider va offline."
