        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשספק לא מצליח להגיע לאתר, החיבור מועבר ליציאה אחרת במקום להישאר תלוי"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब कोई प्रदाता किसी साइट तक नहीं पहुँच पाता, तो कनेक्शन को लटकने देने के बजाय दूसरे एग्ज़िट पर ले जाएँ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat penyedia tidak dapat menjangkau situs, pindahkan koneksi ke exit lain alih-alih membiarkannya menggantung"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
