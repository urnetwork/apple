        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa lama probe kualifikasi menunggu jawaban, dalam ms. Nonaktif memakai 4 dtk bawaan. Ini hanya membatasi penantian bukti, tidak pernah memvonis"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
