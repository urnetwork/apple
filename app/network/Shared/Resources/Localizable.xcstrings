          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette signature ne provient pas de l'adresse que vous avez saisie. Dans %@, signez le message avec cette adresse, puis collez à nouveau la signature."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החתימה הזו אינה מהכתובת שהזנתם. ב-%@, חתמו על ההודעה עם הכתובת שהזנתם, ואז הדביקו שוב את החתימה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह हस्ताक्षर आपके दर्ज किए गए पते का नहीं है। %@ में उस पते से संदेश पर हस्ताक्षर करें, फिर हस्ताक्षर दोबारा पेस्ट करें।"
