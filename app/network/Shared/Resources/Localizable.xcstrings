    "Continue in your browser: scan the code with your wallet app, or open the wallet on this device." : {
      "comment" : "Shown while the browser is open on the WalletConnect page: the user scans the code or opens their wallet app there.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع في متصفحك: امسح الرمز باستخدام تطبيق محفظتك، أو افتح المحفظة على هذا الجهاز."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokračujte v prohlížeči: naskenujte kód aplikací své peněženky, nebo peněženku otevřete na tomto zařízení."
