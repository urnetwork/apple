    "Staying on this exit. If it goes offline, choose another location." : {
      "comment" : "Muted line on the provider the connection already stays on (after Stay on this exit), in the Provider Locations sheet. Says how to leave it.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
