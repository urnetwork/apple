    "Write it down and store it somewhere safe. If you lose it, you'll lose access to your account." : {
      "comment" : "A warning message that instructs the user to write down their seedphrase and store it in a secure location.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتبها واحفظها في مكان آمن. إذا فقدتها، ستفقد إمكانية الوصول إلى حسابك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapište si ji a uložte na bezpečné místo. Pokud ji ztratíte, přijdete o přístup ke svému účtu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibe sie auf und bewahre sie an einem sicheren Ort auf. Wenn du sie verlierst, verlierst du den Zugriff auf dein Konto."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράψτε την και φυλάξτε την σε ασφαλές μέρος. Αν τη χάσετε, θα χάσετε την πρόσβαση στον λογαριασμό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write it down and store it somewhere safe. If you lose it, you'll lose access to your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anótala y guárdala en un lugar seguro. Si la pierdes, perderás el acceso a tu cuenta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anótala y guárdala en un lugar seguro. Si la pierdes, perderás el acceso a tu cuenta."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anótala y guárdala en un lugar seguro. Si la pierdes, perderás el acceso a tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez-la et conservez-la en lieu sûr. Si vous la perdez, vous perdrez l’accès à votre compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רשום אותו ושמור אותו במקום בטוח. אם תאבד אותו, תאבד את הגישה לחשבון שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे लिखकर किसी सुरक्षित जगह पर रखें। अगर यह खो गया, तो आप अपने खाते तक पहुंच खो देंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis dan simpan di tempat yang aman. Jika hilang, Anda akan kehilangan akses ke akun Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annotala e conservala in un luogo sicuro. Se la perdi, perderai l’accesso al tuo account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き留めて安全な場所に保管してください。紛失すると、アカウントにアクセスできなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적어서 안전한 곳에 보관하세요. 잃어버리면 계정에 접근할 수 없게 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf hem op en bewaar hem op een veilige plek. Als je hem kwijtraakt, verlies je de toegang tot je account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz ją i przechowuj w bezpiecznym miejscu. Jeśli ją zgubisz, stracisz dostęp do swojego konta."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva-a e guarde-a num local seguro. Se a perder, perde o acesso à sua conta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote-a e guarde-a em um local seguro. Se você perdê-la, perderá o acesso à sua conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva-a e guarde-a num local seguro. Se a perder, perde o acesso à sua conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите её и храните в надёжном месте. Если вы её потеряете, то потеряете доступ к аккаунту."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv ner den och förvara den på ett säkert ställe. Om du tappar bort den förlorar du åtkomsten till ditt konto."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จดไว้และเก็บในที่ปลอดภัย หากทำหาย คุณจะเข้าถึงบัญชีของคุณไม่ได้อีก"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишіть її та зберігайте в надійному місці. Якщо ви її втратите, то втратите доступ до свого облікового запису."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy ghi lại và cất giữ ở nơi an toàn. Nếu làm mất, bạn sẽ mất quyền truy cập vào tài khoản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请抄写下来并存放在安全的地方。一旦丢失，你将无法再访问你的帐户。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請抄寫下來並存放在安全的地方。一旦遺失，你將無法再存取你的帳戶。"
          }
        }
      }
    },
