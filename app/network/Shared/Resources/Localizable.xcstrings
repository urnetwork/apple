    "Turn URnetwork on and off from Control Center, and keep an eye on it from your Home Screen." : {
      "comment" : "Detail line of the last onboarding page on iOS/macOS (Control Center instead of Quick Settings).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل URnetwork وأوقفه من مركز التحكم، وتابعه من شاشتك الرئيسية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapínejte a vypínejte URnetwork z Ovládacího centra a sledujte ho z plochy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte URnetwork im Kontrollzentrum ein und aus und behalte es auf deinem Home-Bildschirm im Blick."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε και απενεργοποιήστε το URnetwork από το Κέντρο ελέγχου και παρακολουθήστε το από την οθόνη Αφετηρίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn URnetwork on and off from Control Center, and keep an eye on it from your Home Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa y desactiva URnetwork desde el Centro de control y vigílalo desde tu pantalla de inicio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
