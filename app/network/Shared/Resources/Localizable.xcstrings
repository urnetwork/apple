    "Warning: one or more custom endpoints are not using HTTPS/WSS. Traffic may be unencrypted." : {
      "comment" : "Warning shown when a custom endpoint uses plain HTTP/WS instead of HTTPS/WSS.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحذير: نقطة نهاية مخصصة واحدة أو أكثر لا تستخدم HTTPS/WSS. قد تكون حركة المرور غير مشفرة."
          }
        },
        "cs" : {
