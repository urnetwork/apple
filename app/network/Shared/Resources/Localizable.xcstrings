          "stringUnit" : {
            "state" : "translated",
            "value" : "A variedade de IPs encaminháveis da sua rede está por volta da posição #%1$lld de %2$lld lugares principais. Os mineradores principais ganham SN25α nativamente, em cada tempo."
          }
