    "%@ is reserved for your open connections. What they don't use is returned as they close." : {
      "comment" : "Out-of-balance notice (and the Upgrade screen when a blocked connect opened it), shown when most of what is missing is held by open connections rather than used up. {amount} is the reserved (Pending) data as a size, e.g. 1.4 GB. The unused part is returned as those connections close. Do not add a time promise.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ محجوزة لاتصالاتك المفتوحة. ما لا تستخدمه منها يُعاد عند إغلاقها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je rezervováno pro vaše otevřená připojení. Co nevyužijí, se vrátí, až se ukončí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sind für deine offenen Verbindungen reserviert. Was sie nicht verbrauchen, wird zurückgegeben, sobald sie geschlossen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ είναι δεσμευμένα για τις ανοιχτές συνδέσεις σας. Ό,τι δεν χρησιμοποιήσουν επιστρέφεται καθώς κλείνουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is reserved for your open connections. What they don't use is returned as they close."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ están reservados para tus conexiones abiertas. Lo que no usen se devuelve a medida que se cierran."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ están reservados para tus conexiones abiertas. Lo que no usen se devuelve a medida que se cierran."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
