        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αγορά βρέθηκε. Επιβεβαιώνουμε το πρόγραμμά σας — θα ενημερωθεί αυτόματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
