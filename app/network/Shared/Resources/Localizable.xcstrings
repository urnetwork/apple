    "One hostname or IP address per line. These are added to the discovered extenders." : {
      "comment" : "Help text under the manual extender list field.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسم مضيف أو عنوان IP واحد في كل سطر. تُضاف هذه إلى الموسّعات المكتشفة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden název hostitele nebo IP adresa na řádek. Přidají se k nalezeným extenderům."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Hostname oder eine IP-Adresse pro Zeile. Diese werden zu den gefundenen Extendern hinzugefügt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα όνομα κεντρικού υπολογιστή ή μία διεύθυνση IP ανά γραμμή. Προστίθενται στους επεκτατές που εντοπίστηκαν."
          }
        },
        "en" : {
