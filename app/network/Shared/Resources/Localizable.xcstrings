    "Provides to everyone while you're connected, otherwise only to your own devices." : {
      "comment" : "One-line explanation of the Auto provide mode in the onboarding Contribute bandwidth picker: public providing only while connected, same-network peers otherwise.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوفّر للجميع أثناء اتصالك، وإلا فلأجهزتك فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskytuje všem, když jste připojeni, jinak jen vašim vlastním zařízením."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt allen bereit, während du verbunden bist, sonst nur deinen eigenen Geräten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρέχει σε όλους όσο είστε συνδεδεμένοι, αλλιώς μόνο στις δικές σας συσκευές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provides to everyone while you're connected, otherwise only to your own devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proporciona a todos mientras estás conectado; si no, solo a tus propios dispositivos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proporciona a todos mientras estás conectado; si no, solo a tus propios dispositivos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proporciona a todos mientras estás conectado; si no, solo a tus propios dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournit à tout le monde pendant que vous êtes connecté, sinon uniquement à vos propres appareils."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מספק לכולם בזמן שאתם מחוברים, ואחרת רק למכשירים שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप कनेक्ट हों तब सभी को प्रदान करता है, वरना सिर्फ़ आपके अपने डिवाइस को।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyediakan untuk semua orang saat Anda terhubung, selain itu hanya untuk perangkat Anda sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornisce a tutti mentre sei connesso, altrimenti solo ai tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続中はすべての人に提供し、それ以外は自分のデバイスにのみ提供します。"
