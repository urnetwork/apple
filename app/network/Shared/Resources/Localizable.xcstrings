    "Emission is paid to your coldkey directly. Bindings renew per epoch." : {
      "comment" : "Detail under the bound status.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُدفع مكافآت الإصدار مباشرةً إلى coldkey الخاص بك. تتجدد عمليات الربط في كل فترة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emise se vyplácí přímo na váš coldkey. Vazby se obnovují každou epochu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Emission wird direkt an deinen Coldkey ausgezahlt. Bindungen werden pro Epoche erneuert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η έκδοση καταβάλλεται απευθείας στο coldkey σας. Οι δεσμεύσεις ανανεώνονται σε κάθε εποχή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emission is paid to your coldkey directly. Bindings renew per epoch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La emisión se paga directamente a tu coldkey. Las vinculaciones se renuevan en cada época."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La emisión se paga directamente a tu coldkey. Las vinculaciones se renuevan en cada época."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La emisión se paga directamente a tu coldkey. Las vinculaciones se renuevan en cada época."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’émission est versée directement sur votre coldkey. Les liaisons se renouvellent à chaque époque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההנפקה משולמת ישירות ל-coldkey שלכם. הקישורים מתחדשים בכל תקופה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एमिशन का भुगतान सीधे आपकी coldkey पर होता है। बाइंडिंग हर एपोक में नवीनीकृत होती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emisi dibayarkan langsung ke coldkey Anda. Pengikatan diperbarui setiap epoch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’emissione viene pagata direttamente sulla tua coldkey. I vincoli si rinnovano a ogni epoca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エミッションは coldkey に直接支払われます。バインドはエポックごとに更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
