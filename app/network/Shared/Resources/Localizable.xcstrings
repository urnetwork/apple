        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornece a todos enquanto está ligado; caso contrário, apenas aos seus próprios dispositivos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornece para todos enquanto você está conectado; caso contrário, só para os seus próprios dispositivos."
