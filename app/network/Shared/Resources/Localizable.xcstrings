            "value" : "Η συνδρομή σας αγοράστηκε με άλλον λογαριασμό. Συνδεθείτε σε εκείνον τον λογαριασμό για να τη χρησιμοποιήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your subscription was purchased under a different account. Log in to that account to use it."
          }
        },
        "es" : {
