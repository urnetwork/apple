    "Purchase found. Confirming your plan — it will update automatically." : {
      "comment" : "Restore-purchases outcome: an entitlement for the current network was found; the confirmation poll now bridges the gap until the server credits it (Shared/ViewModels/AppStoreSubscriptionManager.swift).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم العثور على عملية الشراء. جارٍ تأكيد خطتك — سيتم تحديثها تلقائيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
