          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva e disattiva URnetwork da Centro di Controllo e tienilo d’occhio dalla schermata Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールセンターから URnetwork のオンとオフを切り替え、ホーム画面から状態を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
