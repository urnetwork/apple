    "This request expired. Start again to get a new message to sign." : {
      "comment" : "Error: the single-use wallet challenge expired (5 minutes) before it was signed.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية هذا الطلب. ابدأ من جديد للحصول على رسالة جديدة للتوقيع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platnost tohoto požadavku vypršela. Začněte znovu a získejte novou zprávu k podpisu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anfrage ist abgelaufen. Starte erneut, um eine neue Nachricht zum Signieren zu erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αίτημα έληξε. Ξεκινήστε ξανά για να λάβετε νέο μήνυμα προς υπογραφή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This request expired. Start again to get a new message to sign."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud caducó. Empieza de nuevo para obtener un mensaje nuevo para firmar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud venció. Empieza de nuevo para obtener un mensaje nuevo para firmar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud venció. Empieza de nuevo para obtener un mensaje nuevo para firmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette demande a expiré. Recommencez pour obtenir un nouveau message à signer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוקף הבקשה הזו פג. התחילו מחדש כדי לקבל הודעה חדשה לחתימה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह अनुरोध समाप्त हो गया है। साइन करने के लिए नया संदेश पाने हेतु फिर से शुरू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan ini sudah kedaluwarsa. Mulai lagi untuk mendapatkan pesan baru untuk ditandatangani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa richiesta è scaduta. Ricomincia per ottenere un nuovo messaggio da firmare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリクエストは期限切れです。最初からやり直して、署名する新しいメッセージを取得してください。"
          }
        },
        "ko" : {
