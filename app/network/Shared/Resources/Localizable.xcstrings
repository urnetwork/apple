          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La variedad de IP enrutables de tu red ocupa aproximadamente el puesto #%1$lld de %2$lld puestos principales. Los mineros principales ganan SN25α de forma nativa en cada tempo."
