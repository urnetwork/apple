        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto atraso do timer é interpretado como o telefone suspenso, e não como uma saída travada, em ms, para que um telefone retomado não condene todas as saídas de uma vez. Desativado o desliga"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto atraso do temporizador é interpretado como o telemóvel suspenso, e não como uma saída bloqueada, em ms, para que um telemóvel retomado não condene todas as saídas de uma vez. Desativado desliga-o"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Какое превышение таймера считается приостановкой телефона, а не зависанием выхода, в мс, чтобы после пробуждения телефон не осудил сразу все выходы. Если выключено, детектор не работает"
