<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The widget extension drives the packet tunnel directly (Control Center
  toggle, Home Screen toggle): NETunnelProviderManager needs the Network
  Extension entitlement in every process that loads the configuration, so the
  widget's App ID must have the Network Extensions capability like the app's
  and the tunnel's. The Personal VPN entitlement (vpn.api) is deliberately NOT
  here: it gates the built-in IKEv2/IPsec transports only.
  The App Group is where the app and the tunnel write the widget snapshots and
  the shared connect intent.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.network.ur</string>
	</array>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
</dict>
</plist>
