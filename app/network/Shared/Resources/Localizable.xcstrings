    "No speed test yet. Until one completes, clients are offered this device much less often." : {
      "comment" : "Provider status reason (speed_test_missing).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُجرَ اختبار سرعة بعد. وإلى أن يكتمل أحدها، يُعرض هذا الجهاز على العملاء بوتيرة أقل بكثير."
          }
        },
        "cs" : {
          "stringUnit" : {
