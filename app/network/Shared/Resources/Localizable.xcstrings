        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 위치에서 예상되는 수준보다 높게 측정된 지연입니다. 지연이 낮을수록 더 자주 제시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertraging gemeten boven wat voor deze locatie wordt verwacht. Lagere vertraging wordt vaker aangeboden."
          }
        },
        "pl" : {
          "stringUnit" : {
