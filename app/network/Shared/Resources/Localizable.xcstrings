    "WalletConnect is not available right now. Try again later, or enter your address manually." : {
      "comment" : "Bittensor wallet error in the apps, when the ur.io bridge page returns walletconnect_unavailable: the page has no WalletConnect project id, so it cannot pair a wallet. Manual entry still works. WalletConnect is a product name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WalletConnect غير متاح حاليًا. حاول مرة أخرى لاحقًا، أو أدخل عنوانك يدويًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WalletConnect teď není k dispozici. Zkuste to později znovu, nebo zadejte adresu ručně."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WalletConnect ist gerade nicht verfügbar. Versuche es später erneut oder gib deine Adresse manuell ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το WalletConnect δεν είναι διαθέσιμο αυτή τη στιγμή. Δοκιμάστε ξανά αργότερα ή εισαγάγετε τη διεύθυνσή σας χειροκίνητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
