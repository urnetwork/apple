          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действия — это запросы: проверяйте их результат в измерениях и строках выходов, которые обновляются ниже."
          }
        },
        "sv" : {
          "stringUnit" : {
